# Copy to .env and fill in. Never commit .env: it holds your two keys.

# Your TENANT key (adp_...), from your tenant portal on adona-robot.com: /v1/prop.
ADONA_TENANT_KEY=
# Your DATA key (adk_...), from your data account on adona-robot.com: /v1 live prices.
ADONA_DATA_KEY=
# Where Adona Robot answers.
ADONA_API=https://api.adona-robot.com

# The DEMO sign-in: user name -> the external_ref you gave the trader when you invited them.
DEMO_USERS=alice:your-ref-for-alice,bob:your-ref-for-bob

# This machine only while the demo sign-in is in place.
HOST=127.0.0.1
PORT=8080
